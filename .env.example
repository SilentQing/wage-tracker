# Copy to .env and fill in a private password to enable HTTP Basic authentication.
WAGE_USERNAME=admin
WAGE_PASSWORD=

# Upload to an existing HTTPS WebDAV directory. Enable only after NAS setup.
# Credentials stay in deployment configuration; never commit the real .env.
WAGE_WEBDAV_ENABLED=false
WAGE_WEBDAV_URL=
WAGE_WEBDAV_USERNAME=
WAGE_WEBDAV_PASSWORD=
